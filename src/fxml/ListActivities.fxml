<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.ListActivitiesController">

    <center>
        <VBox fillWidth="true" prefHeight="511.0" prefWidth="507.0" spacing="20">

            <padding>
                <Insets bottom="30" left="30" right="30" top="20" />
            </padding>

            <children>

                <Text styleClass="title" text="Activities Manager" textAlignment="CENTER" wrappingWidth="462.0755157470703">
                    <font>
                        <Font size="18" />
                    </font>
                </Text>
            <HBox alignment="CENTER" prefHeight="37.0" prefWidth="657.0">
               <children>
                  <Button fx:id="newButton" mnemonicParsing="false" onAction="#loadNewActivity" prefHeight="25.0" prefWidth="128.0" text="New activity" />
               </children>
            </HBox>
            <ListView fx:id="listview" prefHeight="418.0" prefWidth="147.0" VBox.vgrow="ALWAYS" />
            <HBox alignment="TOP_RIGHT" prefHeight="37.0" prefWidth="657.0">
               <children>
                  <Button fx:id="openButton" onAction="#confirmSelection" styleClass="openButton" text="Open selected activity" />
               </children>
            </HBox>
            </children>

        </VBox>
    </center>

</BorderPane>
