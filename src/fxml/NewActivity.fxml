<BorderPane prefHeight="268.0" prefWidth="854.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.NewActivityController">
   <center>
      <VBox prefHeight="244.0" prefWidth="854.0" stylesheets="@../resources/estilos.css">
         <children>
            <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="newTitle" text="Register new activity" textAlignment="RIGHT" wrappingWidth="281.13671875">
               <font>
                  <Font size="25.0" />
               </font>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </Text>
            <Region prefHeight="41.0" prefWidth="854.0" />
            <HBox prefHeight="49.0" prefWidth="854.0">
               <children>
                  <Region prefHeight="53.0" prefWidth="55.0" />
                  <Label prefHeight="159.0" prefWidth="137.0" styleClass="label-upload" text="GPX file:">
                     <font>
                        <Font size="21.0" />
                     </font>
                  </Label>
                  <Button fx:id="uploadButton" alignment="CENTER" mnemonicParsing="false" prefHeight="154.0" prefWidth="126.0" styleClass="uploadButton">
                     <graphic>
                        <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
                           <children>
                              <ImageView fitHeight="106.0" fitWidth="31.0" pickOnBounds="true" preserveRatio="true">
                                 <image>
                                    <Image url="@../resources/icons/upload.png" />
                                 </image>
                              </ImageView>
                              <Text strokeType="OUTSIDE" strokeWidth="0.0" styleClass="uploadLabel" text="Upload" wrappingWidth="78.13671875">
                                 <font>
                                    <Font size="23.0" />
                                 </font>
                              </Text>
                           </children>
                        </HBox>
                     </graphic>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor></Button>
                  <Region prefHeight="47.0" prefWidth="37.0" />
                  <Text fx:id="filenameLabel" fill="#9a9a9a" strokeType="OUTSIDE" strokeWidth="0.0" styleClass="placeholderFile" text="UPVTour.gpx" wrappingWidth="230.13671875">
                     <font>
                        <Font size="11.0" />
                     </font>
                     <HBox.margin>
                        <Insets top="15.0" />
                     </HBox.margin>
                  </Text>
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" prefHeight="52.0" prefWidth="842.0" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets bottom="6.0" left="6.0" right="6.0" top="6.0" />
         </BorderPane.margin>
         <children>
            <Button fx:id="cancelButton" mnemonicParsing="false" style="-fx-background-color: #c2c2c2;" styleClass="cancelButton" text="Cancel">
               <HBox.margin>
                  <Insets right="40.0" />
               </HBox.margin>
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
               <cursor>
                  <Cursor fx:constant="HAND" />
               </cursor>
            </Button>
            <Button fx:id="createButton" mnemonicParsing="false" prefHeight="39.0" prefWidth="100.0" style="-fx-background-color: #008000;" styleClass="createButton" text="Create" textFill="WHITE">
               <HBox.margin>
                  <Insets right="30.0" />
               </HBox.margin>
               <graphic>
                  <ImageView fitHeight="29.0" fitWidth="29.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@../resources/icons/check-svgrepo-com.png" />
                     </image>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </ImageView>
               </graphic>
               <font>
                  <Font name="System Bold" size="14.0" />
               </font>
            </Button>
         </children>
      </HBox>
   </bottom>
